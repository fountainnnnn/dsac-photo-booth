# Copy this file to .env and fill in your values before the event.

# ── Deploying on Railway ─────────────────────────────────────────────────────
#
# You do NOT need to set anything here for Railway. Just attach a Volume to the
# service (right-click the project canvas -> Volume, mount path /data).
#
# Railway then injects RAILWAY_VOLUME_MOUNT_PATH and RAILWAY_PUBLIC_DOMAIN
# automatically, and the server picks both up: photos persist across redeploys,
# and QR codes get the real https domain.
#
# Attaching the volume is the step that matters. Without it the app still runs,
# but photos live on the container filesystem and are destroyed on the next
# redeploy — QR codes handed out at the event start 404-ing. The server logs a
# warning on boot if it detects Railway with no volume attached.

# Override the storage location. Leave blank on Railway (the volume mount path
# is detected automatically). Local default: the project root.
STORAGE_DIR=

# ── Running locally ──────────────────────────────────────────────────────────

# Public URL baked into QR codes (recommended when guests are on mobile data).
# Guests on cellular cannot reach the kiosk's LAN IP, so use a tunnel:
#
# Option A - Cloudflare Tunnel:
#   npx cloudflared tunnel --url http://localhost:5173
#   Copy the *.trycloudflare.com URL it prints, paste below.
#
# Option B - ngrok:
#   ngrok http 5173
#   Copy the https://*.ngrok-free.app URL it prints, paste below.
#
# Leave blank to fall back to the LAN IP (same-network only).
PUBLIC_URL=

# Server ports (optional - defaults shown). Railway injects PORT itself.
PORT=3001
FRONTEND_PORT=5173

# Storage driver. "local" writes photos/QRs to disk and keeps the token index
# in records.json. To host on a serverless platform (e.g. Cloudflare), add an
# R2/S3 driver in server/storage/ and set STORAGE_DRIVER=r2.
STORAGE_DRIVER=local

# How many days a download link stays live before the photo is auto-deleted.
PHOTO_TTL_DAYS=7
