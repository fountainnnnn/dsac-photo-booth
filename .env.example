# Copy this file to .env and fill in your values before the event.

# Override the storage location. Local default: the project root.
STORAGE_DIR=

# ── Running locally ──────────────────────────────────────────────────────────

# Public URL baked into QR codes (recommended when guests are on mobile data).
# Guests on cellular cannot reach the kiosk's LAN IP, so use a tunnel:
#
# Option A - Cloudflare Tunnel:
#   npx cloudflared tunnel --url http://localhost:5173
#   Copy the *.trycloudflare.com URL it prints, paste below.
#
# Option B - ngrok:
#   ngrok http 5173
#   Copy the https://*.ngrok-free.app URL it prints, paste below.
#
# Leave blank to fall back to the LAN IP (same-network only).
PUBLIC_URL=

# Server ports (optional - defaults shown).
PORT=3001
FRONTEND_PORT=5173

# How many days a download link stays live, for a booth whose Settings have
# never been saved. Once they have, the `linkTtlHours` capture setting wins.
# Nothing is auto-deleted either way: an expired link hides the photo from the
# guest, not from the gallery.
PHOTO_TTL_DAYS=7

# The booth password. Leave unset and the booth is open; it can also be set
# on the Environment tab in Settings while the booth runs. Guests' photos have
# no password: their links are unguessable.
# BOOTH_PASSWORD=change-me      # locks capture/gallery/settings and the phone remote
